module runtime_state_payload_projection_next_state;

record MainState;

record Job {
    phase: Phase,
}

enum Bool {
    False,
    True,
}

enum Phase {
    Ready,
    Done,
}

enum WorkerState {
    Idle,
    Holding(Job),
    ReadySeen,
    DoneSeen,
}

enum MainMsg {
    Start,
}

enum WorkerMsg {
    Assign(Job),
    Decide,
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let ready_worker: ProcessRef<Worker> = spawn Worker;
        let done_worker: ProcessRef<Worker> = spawn Worker;
        send ready_worker Assign(Job { phase: Ready });
        send ready_worker Decide;
        send done_worker Assign(Job { phase: Done });
        send done_worker Decide;
        return Stop(state);
    }
}

proc Worker mailbox bounded(2) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return Idle;
    }

    fn step(state: WorkerState, Assign(job: Job)) -> ProcResult<WorkerState> ! [] ~ [] @det {
        return Continue(Holding(job));
    }

    fn step(state: WorkerState, Decide) -> ProcResult<WorkerState> ! [] ~ [] @det {
        match state {
            Idle => {
                return Continue(Idle);
            }
            Holding(Job { phase: held_phase }) => {
                if (held_phase == Ready) {
                    return Continue(ReadySeen);
                } else {
                    return Continue(DoneSeen);
                }
            }
            ReadySeen => {
                return Continue(ReadySeen);
            }
            DoneSeen => {
                return Continue(DoneSeen);
            }
        }
    }
}
