module source_contract_data_primitives;

record MainState;
record DataBundle {
    label: String,
    raw: Bytes,
    tags: List<String,2>,
    lookup: Map<String,Bytes,2>,
}
record WorkerState {
    current: DataBundle,
    label_ok: Bool,
    raw_ok: Bool,
}

enum MainMsg { Start }
enum WorkerMsg { Replace(DataBundle) }

fn primary_label(DataBundle { label }) -> String ! [] ~ [] @det {
    return label;
}

fn primary_raw(DataBundle { raw }) -> Bytes ! [] ~ [] @det {
    return raw;
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    authority spawn_worker: Cap<Spawn<Worker>>;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let worker: ProcessRef<Worker> = spawn Worker;
        send worker Replace(DataBundle {
            label: "ready",
            raw: b"\x01\x02bin",
            tags: List<String,2>["ready", "done"],
            lookup: Map<String,Bytes,2>["ready" => b"\x01", "done" => b"\x02"],
        });
        return Stop(state);
    }
}

proc Worker mailbox bounded(1) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return WorkerState {
            current: DataBundle {
                label: primary_label(DataBundle {
                    label: "ready",
                    raw: b"\x01\x02bin",
                    tags: List<String,2>["ready", "done"],
                    lookup: Map<String,Bytes,2>["ready" => b"\x01", "done" => b"\x02"],
                }),
                raw: primary_raw(DataBundle {
                    label: "ready",
                    raw: b"\x01\x02bin",
                    tags: List<String,2>["ready", "done"],
                    lookup: Map<String,Bytes,2>["ready" => b"\x01", "done" => b"\x02"],
                }),
                tags: List<String,2>["ready", "done"],
                lookup: Map<String,Bytes,2>["ready" => b"\x01", "done" => b"\x02"],
            },
            label_ok: True,
            raw_ok: True,
        };
    }

    fn step(state: WorkerState, Replace(DataBundle { label, raw, tags, lookup })) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        if (label == "ready" && raw == b"\x01\x02bin") {
            emit "typed String and Bytes survived Mantle";
        } else {
        }
        return Stop(WorkerState {
            current: DataBundle { label: label, raw: raw, tags: tags, lookup: lookup },
            label_ok: True,
            raw_ok: True,
        });
    }
}
