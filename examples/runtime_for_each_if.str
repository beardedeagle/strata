module runtime_for_each_if;

record MainState;
enum MainMsg {
    Start,
}

enum BatchState {
    Ready,
}

enum BatchMsg {
    Batch(List<Bool,2>),
}

enum WorkerState {
    Waiting,
}

enum WorkerMsg {
    Branch(Bool),
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    authority spawn_batch_worker: Cap<Spawn<BatchWorker>>;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let batch: ProcessRef<BatchWorker> = spawn BatchWorker;
        send batch Batch(List<Bool,2>[True, False]);
        return Stop(state);
    }
}

proc BatchWorker mailbox bounded(1) {
    type State = BatchState;
    type Msg = BatchMsg;

    authority spawn_worker: Cap<Spawn<Worker>>;

    fn init() -> BatchState ! [] ~ [] @det {
        return Ready;
    }

    fn step(state: BatchState, Batch(items: List<Bool,2>)) -> ProcResult<BatchState> ! [spawn, emit, send] ~ [] @det {
        let worker: ProcessRef<Worker> = spawn Worker;
        for item in items {
            if ((item != False) && !(item == False)) {
                emit "batch selected true";
                send worker Branch(item);
            } else {
                emit "batch selected false";
                send worker Branch(item);
            }
        }
        return Stop(state);
    }
}

proc Worker mailbox bounded(2) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return Waiting;
    }

    fn step(state: WorkerState, Branch(flag: Bool)) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        if (flag == True) {
            emit "worker handled true";
        } else {
            emit "worker handled false";
        }
        return Continue(state);
    }
}
