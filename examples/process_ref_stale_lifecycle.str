module process_ref_stale_lifecycle;

record MainState;
record WorkerState;
record SenderState { sent: Result<Unit,SendError<WorkerMsg>> }

enum MainMsg { Start }
enum WorkerMsg { StopNow, Work }
enum SenderMsg { Attempt(ProcessRef<Worker>) }

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    authority spawn_worker: Cap<Spawn<Worker>>;
    authority spawn_sender: Cap<Spawn<Sender>>;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let stale_worker: ProcessRef<Worker> = spawn Worker;
        let live_worker: ProcessRef<Worker> = spawn Worker;
        let sender: ProcessRef<Sender> = spawn Sender;
        send stale_worker StopNow;
        send sender Attempt(stale_worker);
        return Stop(state);
    }
}

proc Worker mailbox bounded(1) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return WorkerState;
    }

    fn step(state: WorkerState, StopNow) -> ProcResult<WorkerState> ! [] ~ [] @det {
        return Stop(state);
    }

    fn step(state: WorkerState, Work) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        emit "live worker should not receive stale send";
        return Stop(state);
    }
}

proc Sender mailbox bounded(1) {
    type State = SenderState;
    type Msg = SenderMsg;

    fn init() -> SenderState ! [] ~ [] @det {
        return SenderState { sent: Err(Full(Work)) };
    }

    fn step(state: SenderState, Attempt(worker: ProcessRef<Worker>)) -> ProcResult<SenderState> ! [emit, send] ~ [] @det {
        let sent: Result<Unit,SendError<WorkerMsg>> = send worker Work;
        if (sent == Err(Stopped(Work))) {
            emit "stale ref stopped";
        } else {
            emit "unexpected stale ref outcome";
        }
        return Stop(SenderState { sent: sent });
    }
}
