module actor_payload_split_signature_wildcard;

record MainState;
enum Phase {
    Ready,
    Done,
}
enum Routed {
    Assign(Phase),
}
enum MainMsg {
    Start,
}
enum WorkerState {
    Waiting,
    SawReady,
    Done,
}
enum WorkerMsg {
    Envelope(Routed),
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let worker: ProcessRef<Worker> = spawn Worker;
        send worker Envelope(Assign(Ready));
        send worker Envelope(Assign(Done));
        return Stop(state);
    }
}

proc Worker mailbox bounded(2) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return Waiting;
    }

    fn step(state: WorkerState, Envelope(Assign(Ready))) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        emit "worker handled Ready assignment";
        return Continue(SawReady);
    }

    fn step(state: WorkerState, _) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        emit "worker handled fallback assignment";
        return Stop(Done);
    }
}
