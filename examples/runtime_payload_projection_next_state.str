module runtime_payload_projection_next_state;

record MainState;

record Job {
    phase: Phase,
}

enum Bool {
    False,
    True,
}

enum Phase {
    Ready,
    Done,
}

enum WorkerState {
    Idle,
    ReadySeen,
    DoneSeen,
}

enum MainMsg {
    Start,
}

enum WorkerMsg {
    Assign(Job),
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    authority spawn_worker: Cap<Spawn<Worker>>;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let ready_worker: ProcessRef<Worker> = spawn Worker;
        let done_worker: ProcessRef<Worker> = spawn Worker;
        send ready_worker Assign(Job { phase: Ready });
        send done_worker Assign(Job { phase: Done });
        return Stop(state);
    }
}

proc Worker mailbox bounded(1) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return Idle;
    }

    fn step(state: WorkerState, Assign(Job { phase: assigned_phase })) -> ProcResult<WorkerState> ! [] ~ [] @det {
        if (assigned_phase == Ready) {
            return Continue(ReadySeen);
        } else {
            return Continue(DoneSeen);
        }
    }
}
