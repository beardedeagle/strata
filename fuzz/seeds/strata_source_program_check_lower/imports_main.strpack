module imports_main_seed;
import imports_types_seed;
import imports_worker_seed;

record MainState;
enum MainMsg {
    Start,
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    authority spawn_worker: Cap<Spawn<Worker>>;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState;
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [spawn, send] ~ [] @det {
        let worker: ProcessRef<Worker> = spawn Worker;
        send worker Work(complete(Job { phase: Ready }));
        return Stop(state);
    }
}
--- strata source unit ---
module imports_types_seed;

record Job {
    phase: Phase,
}

enum Phase {
    Ready,
    Done,
}

fn complete(job: Job) -> Job ! [] ~ [] @det {
    return Job { phase: Done };
}
--- strata source unit ---
module imports_worker_seed;
import imports_types_seed;

record WorkerState;
enum WorkerMsg {
    Work(Job),
}

proc Worker mailbox bounded(1) {
    type State = WorkerState;
    type Msg = WorkerMsg;

    fn init() -> WorkerState ! [] ~ [] @det {
        return WorkerState;
    }

    fn step(state: WorkerState, Work(job: Job)) -> ProcResult<WorkerState> ! [emit] ~ [] @det {
        emit "imported worker handled completed job";
        return Stop(state);
    }
}
