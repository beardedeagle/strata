module function_return_if_block_seed;

record MainState {
    selected: Readiness,
}
enum Bool { False, True }
enum Mode { Cold, Warm }
enum Readiness { ColdReady, WarmReady }
enum MainMsg { Start }

fn is_warm(mode: Mode) -> Bool ! [] ~ [] @det {
    return match mode {
        Cold => {
            return False;
        }
        Warm => {
            return True;
        }
    };
}

fn choose(flag: Bool) -> Readiness ! [] ~ [] @det {
    if (flag) {
        return WarmReady;
    } else {
        return ColdReady;
    }
}

proc Main mailbox bounded(1) {
    type State = MainState;
    type Msg = MainMsg;

    fn init() -> MainState ! [] ~ [] @det {
        return MainState { selected: choose(is_warm(Warm)) };
    }

    fn step(state: MainState, Start) -> ProcResult<MainState> ! [] ~ [] @det {
        return Stop(MainState { selected: choose(is_warm(Cold)) });
    }
}
