# Performance smoke baseline and reviewed budget ceilings.
#
# Format: strict key=value.
# Units:
# - All values are unsigned base-10 integers unless explicitly listed as signed.
# - *_nanos values are nanoseconds.
# - *_rss_kib values are KiB.
# - *_bytes values are bytes.
# - reference_net_live_bytes_delta values are signed base-10 byte counts.
# - allocation/deallocation counts are operation counts.
#
# Reference values record the reviewed CI signal when the baseline was written.
# Budget values are enforced ceilings with CI headroom for scheduler variance.

version=1

collection_state.check_lower.iterations=64
collection_state.check_lower.reference_wall_nanos=40324209
collection_state.check_lower.reference_cpu_nanos=40000000
collection_state.check_lower.reference_rss_kib=6352
collection_state.check_lower.reference_allocation_count=149786
collection_state.check_lower.reference_deallocation_count=149786
collection_state.check_lower.reference_allocated_bytes=13823395
collection_state.check_lower.reference_deallocated_bytes=13823395
collection_state.check_lower.reference_net_live_bytes_delta=0
collection_state.check_lower.reference_peak_live_bytes_over_start=52683
collection_state.check_lower.wall_budget_nanos=1000000000
collection_state.check_lower.cpu_budget_nanos=1000000000
collection_state.check_lower.rss_budget_kib=65536
collection_state.check_lower.allocation_count_budget=172000
collection_state.check_lower.deallocation_count_budget=172000
collection_state.check_lower.allocated_bytes_budget=16000000
collection_state.check_lower.deallocated_bytes_budget=16000000
collection_state.check_lower.net_live_bytes_delta_budget=1048576
collection_state.check_lower.peak_live_bytes_over_start_budget=100000

collection_state.in_memory_runtime.iterations=64
collection_state.in_memory_runtime.reference_wall_nanos=11111583
collection_state.in_memory_runtime.reference_cpu_nanos=10000000
collection_state.in_memory_runtime.reference_rss_kib=6432
collection_state.in_memory_runtime.reference_allocation_count=70874
collection_state.in_memory_runtime.reference_deallocation_count=70874
collection_state.in_memory_runtime.reference_allocated_bytes=5049891
collection_state.in_memory_runtime.reference_deallocated_bytes=5049891
collection_state.in_memory_runtime.reference_net_live_bytes_delta=0
collection_state.in_memory_runtime.reference_peak_live_bytes_over_start=28317
collection_state.in_memory_runtime.wall_budget_nanos=1000000000
collection_state.in_memory_runtime.cpu_budget_nanos=1000000000
collection_state.in_memory_runtime.rss_budget_kib=65536
collection_state.in_memory_runtime.allocation_count_budget=82000
collection_state.in_memory_runtime.deallocation_count_budget=82000
collection_state.in_memory_runtime.allocated_bytes_budget=6000000
collection_state.in_memory_runtime.deallocated_bytes_budget=6000000
